# Octopia API credential dedicated to this tool (separate from Channable's)
OCTOPIA_CLIENT_ID=
OCTOPIA_CLIENT_SECRET=
# Same Seller ID as in the Channable Cdiscount connection
OCTOPIA_SELLER_ID=

# Channable custom export (CSV or JSON). A local file path also works.
CHANNABLE_EXPORT_URL=

# Optional
# BATCH_SIZE=50
# STATE_PATH=state.json
